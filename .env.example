# ==========================================
# #Gyan Labs - Enterprise RAG Configuration
# ==========================================

# Optional: Groq or OpenAI API Key for live LLM inference
# If left blank, the system automatically uses the internal zero-dependency synthesizer!
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# RAG Settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
TOP_K_RESULTS=4
USE_MMR=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
